# Skopiuj do .env; scripts/setup.py tworzy losowe hasło lokalne.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
DATABASE_PATH=data/splot.sqlite3
# Opcjonalnie PostgreSQL (np. Neon). Gdy ustawione, zastępuje DATABASE_PATH.
DATABASE_URL=
SESSION_TTL_SECONDS=3600
# Ustaw true za zaufanym reverse proxy HTTPS.
REQUIRE_HTTPS=false
PORT=8000
